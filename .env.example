# ActSolo.AI — frontend environment template
#
# Copy this file to `.env` and fill in values for local development:
#   cp .env.example .env
#
# NOTE: Every variable here is prefixed with VITE_, which means Vite inlines it
# into the client bundle at build time. These MUST be public-safe values only.
# The Supabase "publishable" key below is the anon key — public by design and
# protected by Row Level Security. Never put service-role keys, the ElevenLabs
# API key, or any other server secret in this file; those live in Supabase
# Edge Function secrets (see Project plans/SUPABASE_WORKFLOW.md).

# Supabase project reference id
VITE_SUPABASE_PROJECT_ID="uomdyqdvorusucuudwnz"

# Supabase anon / publishable key (public, RLS-protected)
